#!/sbin/openrc-run

description="KDS"

command="/opt/kds/kds"
command_args="--config /opt/kds/config.yml"
command_user="www-data"
command_background="yes"

directory="/opt/kds/"
pidfile="/run/kds.pid"

output_log="/var/log/kds.log"
error_log="/var/log/kds.err"

depend() {
    need networking
}

start_pre() {
    checkpath --directory --owner root:root ${pidfile%/*}
    checkpath --file /opt/kds/config.yml
}
